# Single password that unlocks the app
APP_PASSWORD=change-me

# Session signing secret (optional; derived from APP_PASSWORD if empty)
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Time zone used for day boundaries (the container runs in UTC otherwise)
TZ=Europe/Paris

# --- Review scheduler (Anki defaults) ---
# New items introduced per day (each direction of a word counts as one)
NEW_CARDS_PER_DAY=20
# Learning steps for new cards, in minutes
LEARNING_STEPS=1 10
# Relearning steps for forgotten cards, in minutes
RELEARNING_STEPS=10
# Hour at which a new study day starts
NEXT_DAY_STARTS_AT=4

# Set to true if hot reload doesn't pick up changes (Docker Desktop on macOS/Windows)
VITE_POLLING=false

# --- Production only ---
# Only send the session cookie over HTTPS
COOKIE_SECURE=false
# Local port exposed to the reverse proxy (nginx -> 127.0.0.1:APP_PORT)
APP_PORT=3010
