# Mot de passe unique pour accéder à l'app
APP_PASSWORD=change-moi

# Secret de signature des sessions (optionnel, dérivé du mot de passe sinon)
# Génère-en un avec : openssl rand -hex 32
SESSION_SECRET=

# Nouvelles cartes introduites par jour en révision
NEW_CARDS_PER_DAY=20

# Mettre à true si le hot reload ne marche pas (Docker Desktop sur macOS/Windows)
VITE_POLLING=false
