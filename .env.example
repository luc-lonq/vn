# Single password that unlocks the app
APP_PASSWORD=change-me

# Session signing secret (optional; derived from APP_PASSWORD if empty)
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# New cards introduced per day during review
NEW_CARDS_PER_DAY=20

# Set to true if hot reload doesn't pick up changes (Docker Desktop on macOS/Windows)
VITE_POLLING=false

# --- Production only ---
# Only send the session cookie over HTTPS
COOKIE_SECURE=false
# Local port exposed to the reverse proxy (nginx -> 127.0.0.1:APP_PORT)
APP_PORT=3010
